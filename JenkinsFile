pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                // Single checkout for the pipeline; avoid duplicate checkouts
                checkout scmGit(branches: [[name: 'main']], extensions: [], userRemoteConfigs: [[url: 'https://github.com/stckwok/pytest-clouds.git']])
            }
        }
        stage('Build') {
            steps {
                // Source code is already checked out in previous stage
                sh 'python3 namecheck.py'
            }
        }
        stage('Test') {
            steps {
                // Use POSIX path for Linux agents and ensure activation in same shell
                sh 'python3 -m venv venv && . venv/bin/activate && python3 -m pip install --upgrade pip && pip install -r requirements.txt && pytest -v'
            }
        }
    }
}
